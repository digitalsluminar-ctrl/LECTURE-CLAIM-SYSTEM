@model IEnumerable<CLAIM.SYSTEM.POE.Models.Claim>

@{
    ViewData["Title"] = "My Claim History";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Claim History</h2>
        <a asp-action="SubmitClaim" class="btn btn-primary">+ Submit New Claim</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have not submitted any claims yet.
        </div>
    }
    else
    {
        <table class="table table-hover table-bordered shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Claim ID</th>
                    <th>Hours</th>
                    <th>Rate</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th>Submission Date</th>
                    <th>Document</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var claim in Model)
                {
                    <tr>
                        <td>#@claim.ClaimId</td>
                        <td>@claim.HoursWorked</td>
                        <td>R @claim.HourlyRate</td>
                        <td class="fw-bold">R @claim.TotalAmount</td>
                        <td>
                            @if (claim.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (claim.Status == "Approved")
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                        </td>
                        <td>@claim.SubmissionDate.ToShortDateString()</td>
                        <td>
                            @if (!string.IsNullOrEmpty(claim.FileName))
                            {
                                <span class="text-info">Attached</span>
                            }
                            else
                            {
                                <span class="text-muted">No File</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
