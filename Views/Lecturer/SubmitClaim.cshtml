@model CLAIM.SYSTEM.POE.Models.Claim

@{
    ViewData["Title"] = "Submit Monthly Claim";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Submit Monthly Claim</h3>
                </div>
                <div class="card-body">
                    <form asp-action="SubmitClaim" method="post" enctype="multipart/form-data">

                        <div class="form-group mb-3">
                            <label asp-for="HoursWorked" class="control-label fw-bold">Hours Worked</label>
                            <input asp-for="HoursWorked" class="form-control" type="number" step="0.1" placeholder="e.g. 40.5" required />
                            <span asp-validation-for="HoursWorked" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="HourlyRate" class="control-label fw-bold">Hourly Rate (R)</label>
                            <input asp-for="HourlyRate" class="form-control" type="number" step="0.01" placeholder="e.g. 250.00" required />
                            <span asp-validation-for="HourlyRate" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Notes" class="control-label fw-bold">Additional Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Enter module codes or description of work..."></textarea>
                        </div>

                        <div class="form-group mb-4">
                            <label class="control-label fw-bold">Upload Supporting Document</label>
                            <input type="file" name="documentFile" class="form-control" accept=".pdf,.docx,.xlsx" />
                            <small class="text-muted">Allowed files: .pdf, .docx, .xlsx</small>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">Submit Claim</button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}